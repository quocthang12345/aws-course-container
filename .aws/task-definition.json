{
  "family": "course-app-td",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::217512201638:role/course-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::217512201638:role/course-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "PLACEHOLDER",
      "essential": true,
      "stopTimeout": 30,
      "linuxParameters": { "initProcessEnabled": true },
      "portMappings": [ { "containerPort": 8080, "protocol": "tcp" } ],
      "environment": [ { "name": "APP_VERSION", "value": "ci" } ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/course-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
